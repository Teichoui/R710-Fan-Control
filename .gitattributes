# These files run on Linux, and poweredge-fand.pl in particular is
# executed directly via its shebang by systemd (no explicit `perl`
# prefix) - a CRLF-mangled shebang line makes the kernel look for
# "/usr/bin/perl\r", which doesn't exist, and the service fails with
# "No such file or directory".  Force LF regardless of the cloning
# platform's autocrlf setting.
*.pl text eol=lf
*.conf text eol=lf
*.service text eol=lf
hddtemp text eol=lf
megaclisas-status text eol=lf
smart-intercept-spindown text eol=lf
smartctlnvme text eol=lf
