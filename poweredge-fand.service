[Unit]
Description=Dell Poweredge Fan Control Daemon
# Everything lives on the nvme-apps pool because TrueNAS SCALE's root
# filesystem is sealed (no /usr/local writes) and replaced wholesale
# on upgrades.  This unit file itself must be re-installed into
# /etc/systemd/system by a TrueNAS post-init script after an upgrade.
After=zfs-mount.service
RequiresMountsFor=/mnt/nvme-apps

[Service]
ExecStart=/usr/bin/perl /mnt/nvme-apps/scripts/R710-Fan-Control/poweredge-fand.pl -f /mnt/nvme-apps/scripts/R710-Fan-Control/poweredge-fand.conf
Restart=on-failure
# If it's crash-looping (eg someone broke the conf), stop trying and
# leave the machine under iDRAC control rather than flapping between
# manual and automatic mode.
StartLimitIntervalSec=600
StartLimitBurst=5
RestartSec=10
Type=simple

[Install]
Alias=poweredge-fand.service
WantedBy=multi-user.target
